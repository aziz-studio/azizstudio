---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Divider from '../components/ui/Divider.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title={`À propos — ${siteConfig.name}`}
  description="Découvrez le parcours d'Aziz, concepteur web indépendant : ses débuts avec WordPress, sa démarche de conception en 4 étapes, l'assistance par l'IA et l'apprentissage d'Astro."
>
  <!-- =========================================================================
       SECTION 1 — Introduction personnelle
       ========================================================================= -->
  <section class="about-hero">
    <Container>
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item">
            <a href="/" class="breadcrumb__link">Accueil</a>
          </li>
          <li class="breadcrumb__separator" aria-hidden="true">/</li>
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">
            À propos
          </li>
        </ol>
      </nav>

      <div class="about-hero__grid">
        <div class="about-hero__content">
          <span class="about-hero__eyebrow">Aziz Studio — Concepteur web indépendant</span>
          <h1 class="about-hero__title">
            Derrière chaque projet, une idée à faire vivre.
          </h1>
          <p class="about-hero__lead text-muted">
            Je suis Aziz, concepteur web indépendant. J'imagine, structure et réalise des sites web en associant sens du design, maîtrise de WordPress et curiosité pour les nouvelles technologies, avec pour priorité constante la clarté et l'utilité réelle de chaque interface.
          </p>
          <div class="about-hero__actions">
            <Button variant="primary" href="/contact" size="lg" showArrow>
              Prendre contact
            </Button>
            <Button variant="secondary" href="/projets" size="lg">
              Voir mes projets
            </Button>
          </div>
        </div>

        <div class="about-hero__visual">
          <div class="about-portrait">
            <div class="about-portrait__media">
              <img
                src="/images/aziz-studio-vision.webp"
                alt="Portrait d'Aziz — Concepteur web indépendant"
                class="about-portrait__img"
                width="400"
                height="500"
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="about-portrait__caption">
              <span class="about-portrait__name">Aziz</span>
              <span class="about-portrait__sep" aria-hidden="true">—</span>
              <span class="about-portrait__role">Concepteur web indépendant</span>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <Divider />
  </Container>

  <!-- =========================================================================
       SECTION 2 — Mon parcours
       ========================================================================= -->
  <section class="section section--story">
    <Container>
      <div class="story-grid">
        <div class="story-heading">
          <span class="section-eyebrow">Parcours &amp; Évolution</span>
          <h2 class="section-title">De la curiosité initiale à la pratique du web.</h2>
          <p class="story-heading__intro text-muted">
            Un apprentissage continu, nourri par la pratique, l'expérimentation d'outils complémentaires et l'exigence du détail.
          </p>
        </div>

        <div class="story-body">
          <div class="story-paragraph">
            <h3 class="story-paragraph__title">La découverte de la création de sites web</h3>
            <p class="story-paragraph__text text-muted">
              Mon intérêt pour le web est né d'une envie simple : comprendre comment des idées, des textes et des visuels s'organisent sur un écran pour devenir un espace accessible et vivant. Cette curiosité m'a rapidement conduit à vouloir créer moi-même des expériences complètes.
            </p>
          </div>

          <div class="story-paragraph">
            <h3 class="story-paragraph__title">Premières expériences avec WordPress</h3>
            <p class="story-paragraph__text text-muted">
              J'ai débuté mon apprentissage avec l'écosystème WordPress. C'est à travers ce CMS incontournable que j'ai découvert la gestion des contenus, la logique des modèles de pages et la réponse aux besoins réels d'indépendants et d'activités locales.
            </p>
          </div>

          <div class="story-paragraph">
            <h3 class="story-paragraph__title">La pratique d'Elementor, Divi, Gutenberg et WooCommerce</h3>
            <p class="story-paragraph__text text-muted">
              Au fil de mes réalisations, j'ai manipulé différents outils de composition : les constructeurs visuels comme Elementor et Divi pour des mises en page modulaires, l'éditeur de blocs natif Gutenberg pour des architectures plus légères et épurées, ainsi que WooCommerce pour aborder les fondamentaux de la vente en ligne.
            </p>
          </div>

          <div class="story-paragraph">
            <h3 class="story-paragraph__title">L'assistance par l'intelligence artificielle</h3>
            <p class="story-paragraph__text text-muted">
              L'émergence des technologies d'intelligence artificielle a enrichi ma manière de concevoir. J'utilise aujourd'hui ces outils comme de véritables assistants de travail : ils m'aident à clarifier un brief, explorer des pistes ergonomiques, tester des variantes d'arborescence et affiner la formulation des textes.
            </p>
          </div>

          <div class="story-paragraph">
            <h3 class="story-paragraph__title">L'apprentissage d'Astro et le développement continu</h3>
            <p class="story-paragraph__text text-muted">
              Animé par le désir de continuer à progresser, je me suis orienté vers la découverte d'Astro. Le site d'Aziz Studio est le fruit de cet apprentissage : il illustre ma volonté de concevoir des sites toujours plus rapides, bien typés en TypeScript et respectueux des standards modernes.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <Divider />
  </Container>

  <!-- =========================================================================
       SECTION 3 — Ma manière de travailler
       ========================================================================= -->
  <section class="section section--approach">
    <Container>
      <div class="approach-header">
        <span class="section-eyebrow">Approche de travail</span>
        <h2 class="section-title">Une démarche de conception en quatre étapes.</h2>
        <p class="approach-header__lead text-muted">
          Une manière de travailler progressive et structurée, pensée pour garantir la cohérence graphique et la clarté de chaque réalisation.
        </p>
      </div>

      <div class="approach-steps-grid">
        <div class="step-card">
          <div class="step-card__num">01</div>
          <h3 class="step-card__title">Comprendre</h3>
          <p class="step-card__text text-muted">
            Identifier précisément l'idée centrale, les attentes du projet et le public visé pour définir des objectifs clairs.
          </p>
        </div>

        <div class="step-card">
          <div class="step-card__num">02</div>
          <h3 class="step-card__title">Structurer</h3>
          <p class="step-card__text text-muted">
            Organiser les contenus, hiérarchiser les informations et concevoir un parcours de navigation intuitif et fluide.
          </p>
        </div>

        <div class="step-card">
          <div class="step-card__num">03</div>
          <h3 class="step-card__title">Concevoir</h3>
          <p class="step-card__text text-muted">
            Travailler l'interface, équilibrer les espaces, soigner la typographie et établir une présentation visuelle cohérente.
          </p>
        </div>

        <div class="step-card">
          <div class="step-card__num">04</div>
          <h3 class="step-card__title">Réaliser</h3>
          <p class="step-card__text text-muted">
            Construire et intégrer le site web à l'aide des outils les plus adaptés au besoin réel, avec un soin particulier porté au responsive.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <Divider />
  </Container>

  <!-- =========================================================================
       SECTION 4 — Compétences et outils
       ========================================================================= -->
  <section class="section section--skills">
    <Container>
      <div class="skills-header">
        <span class="section-eyebrow">Savoir-faire &amp; Environnement</span>
        <h2 class="section-title">Compétences et outils.</h2>
        <p class="skills-header__lead text-muted">
          Une distinction claire entre les principes de conception web, les environnements CMS maîtrisés, les technologies en cours d'apprentissage et les outils d'assistance.
        </p>
      </div>

      <div class="skills-categories-grid">
        <!-- Catégorie 1 : Savoir-faire de conception web -->
        <div class="skill-category-card">
          <span class="skill-category-card__badge">Compétences</span>
          <h3 class="skill-category-card__title">Conception web</h3>
          <p class="skill-category-card__desc text-muted">
            Principes méthodologiques et ergonomiques au cœur de chaque réalisation.
          </p>
          <ul class="skill-category-card__list">
            <li>Structuration de l'information</li>
            <li>Organisation et hiérarchisation des contenus</li>
            <li>Conception d'interfaces web adaptatives (Responsive)</li>
            <li>Sensibilité typographique et équilibre des contrastes</li>
            <li>Réflexion sur le confort du parcours utilisateur</li>
          </ul>
        </div>

        <!-- Catégorie 2 : WordPress & Constructeurs -->
        <div class="skill-category-card">
          <span class="skill-category-card__badge">CMS &amp; Outils</span>
          <h3 class="skill-category-card__title">WordPress</h3>
          <p class="skill-category-card__desc text-muted">
            Création, personnalisation et gestion de sites vitrines et éditoriaux.
          </p>
          <ul class="skill-category-card__list">
            <li>Gutenberg (éditeur de blocs natif WordPress)</li>
            <li>Elementor (composition et modèles personnalisés)</li>
            <li>Divi (création de pages modulaires)</li>
            <li>WooCommerce (fondamentaux de la boutique en ligne)</li>
          </ul>
        </div>

        <!-- Catégorie 3 : Technologies en apprentissage -->
        <div class="skill-category-card skill-category-card--learning">
          <span class="skill-category-card__badge skill-category-card__badge--accent">En apprentissage</span>
          <h3 class="skill-category-card__title">Technologies en exploration</h3>
          <p class="skill-category-card__desc text-muted">
            Architectures web modernes étudiées pour développer de nouvelles compétences techniques.
          </p>
          <ul class="skill-category-card__list">
            <li>Astro (génération de sites statiques performants)</li>
            <li>TypeScript (mode strict et typage statique)</li>
            <li>CSS natif moderne (variables, grilles et clamp)</li>
          </ul>
          <div class="skill-category-card__note text-subtle">
            Technologies en cours d'apprentissage actif pour concevoir des sites ultra-rapides et légers.
          </div>
        </div>

        <!-- Catégorie 4 : Outils d'assistance IA -->
        <div class="skill-category-card">
          <span class="skill-category-card__badge">Assistance</span>
          <h3 class="skill-category-card__title">Assistance à la conception</h3>
          <p class="skill-category-card__desc text-muted">
            Outils mobilisés comme assistants de travail et d'amplification de la productivité.
          </p>
          <ul class="skill-category-card__list">
            <li>ChatGPT &amp; Claude (structuration de briefs et rédaction)</li>
            <li>Gemini (recherche documentaire et exploration d'idées)</li>
            <li>Cursor &amp; Antigravity (assistance à l'intégration technique)</li>
          </ul>
          <div class="skill-category-card__note text-subtle">
            Utilisés comme outils d'appui méthodologique, au service d'une réflexion et d'une validation humaine.
          </div>
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <Divider />
  </Container>

  <!-- =========================================================================
       SECTION 5 — Conclusion et invitation
       ========================================================================= -->
  <section class="section section--conclusion">
    <Container width="narrow">
      <div class="conclusion-box">
        <span class="section-eyebrow">Collaboration &amp; Échange</span>
        <h2 class="conclusion-box__title">Envie d'échanger autour de votre projet ?</h2>
        <p class="conclusion-box__text text-muted">
          Que vous ayez besoin d'un nouveau site vitrine, d'une refonte WordPress ou simplement envie de partager une réflexion autour de vos interfaces web, je suis à votre écoute pour en discuter.
        </p>
        <div class="conclusion-box__actions">
          <Button variant="primary" href="/contact" size="lg" showArrow>
            Prendre contact
          </Button>
          <a href={siteConfig.whatsappUrl} class="conclusion-whatsapp-link" target="_blank" rel="noopener noreferrer" aria-label="Discuter sur WhatsApp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <Button variant="secondary" href="/projets" size="lg">
            Explorer les projets
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  /* --------------------------------------------------------------------------
     Hero À propos
     -------------------------------------------------------------------------- */
  .about-hero {
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
  }

  .breadcrumb {
    margin-bottom: var(--space-5);
  }

  .breadcrumb__list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--fs-meta);
  }

  .breadcrumb__link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb__link:hover {
    color: var(--color-accent);
  }

  .breadcrumb__separator {
    color: var(--color-border-strong);
  }

  .breadcrumb__item--current {
    color: var(--color-text);
    font-weight: 500;
  }

  .about-hero__grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: var(--space-7);
    align-items: center;
  }

  .about-hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-meta);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .about-hero__title {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    color: var(--color-text);
    margin: 0;
  }

  .about-hero__lead {
    font-size: var(--fs-subheading);
    line-height: 1.65;
    margin: 0;
  }

  .about-hero__actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-top: var(--space-2);
  }

  /* Portrait Éditorial */
  .about-hero__visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .about-portrait {
    box-sizing: border-box;
    width: 100%;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .about-portrait__media {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface-muted);
  }

  .about-portrait__img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    transition: transform var(--transition-base);
  }

  .about-portrait:hover .about-portrait__img {
    transform: scale(1.02);
  }

  .about-portrait__caption {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    padding-inline: var(--space-1);
  }

  .about-portrait__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .about-portrait__sep {
    color: var(--color-border-strong);
  }

  .about-portrait__role {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
  }

  /* --------------------------------------------------------------------------
     Section 2 : Parcours & Évolution
     -------------------------------------------------------------------------- */
  .story-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-7);
    align-items: flex-start;
  }

  .section-eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-meta);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    display: block;
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    color: var(--color-text);
    margin: 0;
  }

  .story-heading__intro {
    font-size: var(--fs-small);
    line-height: 1.6;
    margin-top: var(--space-3);
  }

  .story-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .story-paragraph {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .story-paragraph__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text);
    margin: 0;
  }

  .story-paragraph__text {
    font-size: var(--fs-body);
    line-height: 1.7;
    margin: 0;
  }

  /* --------------------------------------------------------------------------
     Section 3 : Approche en 4 étapes
     -------------------------------------------------------------------------- */
  .approach-header {
    margin-bottom: var(--space-6);
    max-width: 720px;
  }

  .approach-header__lead {
    font-size: var(--fs-subheading);
    line-height: 1.6;
    margin-top: var(--space-2);
  }

  .approach-steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .step-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .step-card__num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-accent);
    line-height: 1;
  }

  .step-card__title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-text);
    margin: 0;
  }

  .step-card__text {
    font-size: var(--fs-small);
    line-height: 1.6;
    margin: 0;
  }

  /* --------------------------------------------------------------------------
     Section 4 : Compétences et outils
     -------------------------------------------------------------------------- */
  .skills-header {
    margin-bottom: var(--space-6);
    max-width: 720px;
  }

  .skills-header__lead {
    font-size: var(--fs-subheading);
    line-height: 1.6;
    margin-top: var(--space-2);
  }

  .skills-categories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .skill-category-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .skill-category-card--learning {
    border-color: var(--color-border-strong);
    background-color: var(--color-surface-muted);
  }

  .skill-category-card__badge {
    align-self: flex-start;
    font-size: var(--fs-meta);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-muted);
    border: 1px solid var(--color-border);
  }

  .skill-category-card__badge--accent {
    color: var(--color-accent);
    border-color: rgba(180, 83, 9, 0.25);
    background-color: rgba(180, 83, 9, 0.08);
  }

  .skill-category-card__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-text);
    margin: 0;
  }

  .skill-category-card__desc {
    font-size: var(--fs-small);
    line-height: 1.5;
    margin: 0;
  }

  .skill-category-card__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--fs-small);
    color: var(--color-text);
  }

  .skill-category-card__list li {
    position: relative;
    padding-left: var(--space-4);
    line-height: 1.5;
  }

  .skill-category-card__list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: bold;
  }

  .skill-category-card__note {
    font-size: var(--fs-meta);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-border);
    line-height: 1.45;
  }

  /* --------------------------------------------------------------------------
     Section 5 : Conclusion & Invitation
     -------------------------------------------------------------------------- */
  .section--conclusion {
    background-color: var(--color-surface-muted);
    border-top: 1px solid var(--color-border);
  }

  .conclusion-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    padding-block: var(--space-4);
  }

  .conclusion-box__title {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    color: var(--color-text);
