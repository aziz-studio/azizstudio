---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Divider from '../../components/ui/Divider.astro';
import Tag from '../../components/ui/Tag.astro';
import Icon from '../../components/ui/Icon.astro';
import { detailedProjects, type DetailedProject, getProjectById } from '../../data/projects';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  return detailedProjects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: DetailedProject;
}

const { project } = Astro.props;
const prevProject = getProjectById(project.prevId);
const nextProject = getProjectById(project.nextId);
const hasLiveUrl = typeof project.liveUrl === 'string' && project.liveUrl.length > 0;
const hasGallery = project.gallery && project.gallery.length > 0;
const hasConclusion = typeof project.conclusion === 'string' && project.conclusion.length > 0;
const scrollDuration = project.scrollDuration || '16s';
const displayUrl = project.displayUrl || (hasLiveUrl ? project.liveUrl!.replace(/^https?:\/\//, '').replace(/\/$/, '') : `${project.id}.demo`);
---

<BaseLayout
  title={`${project.title} — Projet | ${siteConfig.name}`}
  description={project.summary}
>
  <!-- Fil d'Ariane & En-tête du projet -->
  <article class="project-detail">
    <header class="project-hero">
      <Container>
        <nav class="breadcrumb" aria-label="Fil d'Ariane">
          <ol class="breadcrumb__list">
            <li class="breadcrumb__item">
              <a href="/" class="breadcrumb__link">Accueil</a>
            </li>
            <li class="breadcrumb__separator" aria-hidden="true">/</li>
            <li class="breadcrumb__item">
              <a href="/projets" class="breadcrumb__link">Projets</a>
            </li>
            <li class="breadcrumb__separator" aria-hidden="true">/</li>
            <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">
              {project.title}
            </li>
          </ol>
        </nav>

        <div class="project-hero__content">
          <div class="project-hero__tags">
            <Tag label={project.nature} variant="accent" size="sm" />
            <Tag label={project.category} variant="default" size="sm" />
            <Tag label={project.methodOrTech} variant="default" size="sm" />
          </div>

          <h1 class="project-hero__title">{project.title}</h1>

          <p class="project-hero__lead text-muted">
            {project.summary}
          </p>

          <!-- Bouton Voir la démo (externe si hébergé, sinon ancre vers l'aperçu) -->
          <div class="project-hero__cta">
            {hasLiveUrl ? (
              <Button
                variant="primary"
                href={project.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                size="md"
                showArrow
              >
                Voir la démo
              </Button>
            ) : (
              <Button
                variant="primary"
                href="#apercu"
                size="md"
                showArrow
              >
                Voir la démo
              </Button>
            )}
          </div>

          <!-- Fiche d'identité synthétique -->
          <div class="project-meta-grid">
            <div class="project-meta-item">
              <span class="project-meta-item__label">Statut</span>
              <span class="project-meta-item__value">{project.nature}</span>
            </div>
            <div class="project-meta-item">
              <span class="project-meta-item__label">Rôle</span>
              <span class="project-meta-item__value">{project.role}</span>
            </div>
            <div class="project-meta-item">
              <span class="project-meta-item__label">Période</span>
              <span class="project-meta-item__value">{project.period}</span>
            </div>
            <div class="project-meta-item">
              <span class="project-meta-item__label">Méthode &amp; Stack</span>
              <span class="project-meta-item__value">{project.technologies.join(' · ')}</span>
            </div>
          </div>
        </div>
      </Container>
    </header>

    <Container>
      <Divider />
    </Container>

    <!-- Aperçu interactif unique dans mockup navigateur -->
    <section class="section section--mockup" id="apercu">
      <Container>
        <div class="mockup-header-block">
          <div>
            <span class="section-eyebrow">Aperçu interactif</span>
            <h2 class="section-title">Présentation complète du site</h2>
          </div>
          <span class="mockup-hint text-subtle" aria-hidden="true">
            <span class="mockup-hint__desktop">Survolez avec la souris ou utilisez le clavier pour faire défiler la page</span>
            <span class="mockup-hint__touch">Faites défiler le contenu au doigt à l'intérieur du cadre</span>
          </span>
        </div>

        <div
          class="browser-mockup"
          tabindex="0"
          role="region"
          aria-label={`Aperçu interactif du site ${project.title}`}
          style={`--scroll-duration: ${scrollDuration};`}
        >
          <div class="browser-mockup__bar">
            <div class="browser-mockup__dots" aria-hidden="true">
              <span class="browser-mockup__dot browser-mockup__dot--red"></span>
              <span class="browser-mockup__dot browser-mockup__dot--yellow"></span>
              <span class="browser-mockup__dot browser-mockup__dot--green"></span>
            </div>
            <div class="browser-mockup__url">
              <span class="browser-mockup__url-lock" aria-hidden="true">🔒</span>
              <span class="browser-mockup__url-text">{displayUrl}</span>
            </div>
            {hasLiveUrl && (
              <a
                href={project.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="browser-mockup__external-btn"
                title="Ouvrir dans un nouvel onglet"
                aria-label="Ouvrir le site en ligne dans un nouvel onglet"
              >
                <Icon name="arrow-up-right" size={14} />
              </a>
            )}
          </div>

          <div class="browser-mockup__viewport">
            {project.fullImageSrc && (
              <img
                src={project.fullImageSrc}
                alt={`Capture d'écran complète de l'interface conçue pour le site de démonstration ${project.title}`}
                class:list={[
                  'browser-mockup__image',
                  { 'browser-mockup__image--scrollable': project.hasScrollAnimation },
                ]}
                width="1920"
                height="1080"
                loading="eager"
                decoding="async"
              />
            )}
          </div>
        </div>
      </Container>
    </section>

    <!-- Direction artistique & Palette -->
    <section class="section section--palette">
      <Container>
        <div class="project-visual-card">
          <div class="visual-card__header">
            <span class="visual-card__label">Direction artistique &amp; Harmonie chromatique</span>
            <span class="visual-card__notice text-subtle">
              {project.nature} — Identité visuelle
            </span>
          </div>

          <div class="visual-card__canvas" aria-hidden="true">
            <div class="canvas-monogram">
              <span class="canvas-monogram__mark"><Icon name="star-four" size={20} /></span>
              <span class="canvas-monogram__title">{project.title}</span>
              <span class="canvas-monogram__cat">{project.category} · {project.methodOrTech}</span>
            </div>

            <!-- Échantillons de la palette de couleurs -->
            <div class="canvas-palette">
              {project.artDirection.palette.map((color) => (
                <div class="palette-swatch" style={`background-color: ${color};`} title={color}>
                  <span class="palette-swatch__hex">{color}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </Container>
    </section>

    <!-- Contexte & Objectifs -->
    <section class="section section--context">
      <Container>
        <div class="two-col-grid">
          <div class="col-main">
            <span class="section-eyebrow">Contexte &amp; Genèse</span>
            <h2 class="section-title">L'intention derrière ce projet.</h2>
            <p class="section-text">
              {project.context}
            </p>
          </div>

          <div class="col-side">
            <div class="objectives-card">
              <span class="objectives-card__title">Objectifs clés</span>
              <ul class="objectives-list">
                {project.objectives.map((obj) => (
                  <li class="objectives-item">
                    <span class="objectives-item__check" aria-hidden="true">✓</span>
                    <span>{obj}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <Container>
      <Divider />
    </Container>

    <!-- Direction artistique détaillée -->
    <section class="section section--art-direction">
      <Container>
        <div class="art-direction-block">
          <span class="section-eyebrow">Choix visuels &amp; Design</span>
          <h2 class="section-title">Direction artistique &amp; Atmosphère.</h2>

          <div class="art-details-grid">
            <div class="art-detail-card">
              <h3 class="art-detail-card__heading">Ambiance recherchée</h3>
              <p class="art-detail-card__text text-muted">{project.artDirection.ambiance}</p>
            </div>

            <div class="art-detail-card">
              <h3 class="art-detail-card__heading">Palette chromatique</h3>
              <p class="art-detail-card__text text-muted">{project.artDirection.paletteDescription}</p>
            </div>

            <div class="art-detail-card">
              <h3 class="art-detail-card__heading">Typographie &amp; Rythme</h3>
              <p class="art-detail-card__text text-muted">{project.artDirection.typography}</p>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <Container>
      <Divider />
    </Container>

    <!-- Structure & Parcours -->
    <section class="section section--structure">
      <Container>
        <div class="structure-block">
          <span class="section-eyebrow">Parcours &amp; Arborescence</span>
          <h2 class="section-title">Organisation des sections et des écrans.</h2>

          <div class="structure-timeline">
            {project.structure.map((item, index) => (
              <div class="structure-step">
                <div class="structure-step__number">
                  0{index + 1}
                </div>
                <div class="structure-step__content">
                  <h3 class="structure-step__title">{item.title}</h3>
                  <p class="structure-step__desc text-muted">{item.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </section>

    <Container>
      <Divider />
    </Container>

    <!-- Méthode, Contribution & Enseignements -->
    <section class="section section--method-and-role">
      <Container>
        <div class="two-col-grid">
          <div class="method-card">
            <span class="section-eyebrow">Méthode &amp; Technologies</span>
            <h2 class="method-card__title">Comment ce projet a été réalisé.</h2>
            <p class="method-card__text text-muted">
              {project.technologiesDetails}
            </p>
          </div>

          <div class="contribution-card">
            <span class="section-eyebrow">Contribution personnelle</span>
            <h2 class="contribution-card__title">Ce que j'ai réalisé concrètement.</h2>
            <p class="contribution-card__text text-muted">
              {project.contribution}
            </p>
            <div class="learnings-box">
              <span class="learnings-box__title">Enseignements tirés</span>
              <p class="learnings-box__text text-subtle">
                {project.learnings}
              </p>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <Container>
      <Divider />
    </Container>

    <!-- Galerie complémentaire (si disponible) -->
    {hasGallery && (
      <section class="section section--gallery" id="galerie">
        <Container>
          <span class="section-eyebrow">Galerie du projet</span>
          <h2 class="section-title">Pages, sections et détails</h2>
          <div class="gallery-grid">
            {project.gallery!.map((img) => (
              <figure class="gallery-item">
                <div class="gallery-item__frame">
                  <img
                    src={img.src}
                    alt={img.alt}
                    class="gallery-item__image"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                {img.caption && (
                  <figcaption class="gallery-item__caption text-subtle">{img.caption}</figcaption>
                )}
              </figure>
            ))}
          </div>
        </Container>
      </section>
    )}

    {hasGallery && (
      <Container>
        <Divider />
      </Container>
    )}

    <!-- Conclusion de l'étude de cas -->
    {hasConclusion && (
      <section class="section section--conclusion">
        <Container width="narrow">
          <div class="conclusion-block">
            <span class="section-eyebrow">Conclusion</span>
            <h2 class="section-title">Ce qu'il faut retenir de ce projet.</h2>
            <p class="conclusion-block__text text-muted">
              {project.conclusion}
            </p>
            <div class="conclusion-block__action">
              {hasLiveUrl ? (
                <Button
                  variant="secondary"
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  size="md"
                  showArrow
                >
                  Voir la démo en ligne
                </Button>
              ) : (
                <Button
                  variant="secondary"
                  href="#apercu"
                  size="md"
                  showArrow
                >
                  Revoir la démo
                </Button>
              )}
            </div>
          </div>
        </Container>
      </section>
    )}

    {hasConclusion && (
      <Container>
        <Divider />
      </Container>
    )}

    <!-- Navigation inter-projets -->
    <section class="section section--project-nav">
      <Container>
        <div class="project-nav-bar">
          {prevProject ? (
            <a href={`/projets/${prevProject.id}`} class="project-nav-link project-nav-link--prev">
              <span class="project-nav-link__sub" aria-hidden="true"><Icon name="arrow-left" size={14} /> Projet précédent</span>
              <span class="project-nav-link__title">{prevProject.title}</span>
            </a>
          ) : (
            <div class="project-nav-link__placeholder" />
          )}

          <div class="project-nav-bar__center">
            <Button variant="secondary" href="/projets" size="sm">
              Tous les projets
            </Button>
          </div>

          {nextProject ? (
            <a href={`/projets/${nextProject.id}`} class="project-nav-link project-nav-link--next">
              <span class="project-nav-link__sub" aria-hidden="true">Projet suivant <Icon name="arrow-right" size={14} /></span>
              <span class="project-nav-link__title">{nextProject.title}</span>
            </a>
          ) : (
            <div class="project-nav-link__placeholder" />
          )}
        </div>
      </Container>
    </section>

    <Container>
      <Divider />
    </Container>

    <!-- CTA Contact -->
    <section class="section section--detail-cta">
      <Container width="narrow">
        <div class="detail-cta-box">
          <span class="section-eyebrow">Échange &amp; Collaboration</span>
          <h2 class="detail-cta__title">Une approche qui vous parle ?</h2>
          <p class="detail-cta__text text-muted">
            Si cette démarche de conception vous correspond pour votre projet web ou vitrine, échangeons ensemble.
          </p>
          <div class="detail-cta__action">
            <Button variant="primary" href="/contact" size="lg" showArrow>
              Prendre contact
            </Button>
          </div>
        </div>
      </Container>
    </section>
  </article>
</BaseLayout>

<style>
  /* --------------------------------------------------------------------------
     Hero & Breadcrumb
     -------------------------------------------------------------------------- */
  .project-hero {
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
  }

  .breadcrumb {
    margin-bottom: var(--space-5);
  }

  .breadcrumb__list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--fs-meta);
  }

  .breadcrumb__link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb__link:hover {
    color: var(--color-accent);
  }

  .breadcrumb__separator {
    color: var(--color-border-strong);
  }

  .breadcrumb__item--current {
    color: var(--color-text);
    font-weight: 500;
  }

  .project-hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 860px;
  }

  .project-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-hero__title {
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    color: var(--color-text);
    margin: 0;
  }

  .project-hero__lead {
    font-size: var(--fs-subheading);
    line-height: 1.65;
    margin: 0;
  }

  .project-hero__cta {
    padding-top: var(--space-1);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .project-meta-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .project-meta-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .project-meta-item__label {
    font-size: var(--fs-meta);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
  }

  .project-meta-item__value {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--color-text);
  }

  /* --------------------------------------------------------------------------
     Browser Mockup & Interactive Scrolling (Unique Preview)
     -------------------------------------------------------------------------- */
  .mockup-header-block {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-4);
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .mockup-hint {
    font-size: var(--fs-meta);
    text-align: right;
  }

  .mockup-hint__touch {
    display: none;
  }

  .browser-mockup {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.08);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .browser-mockup:hover,
  .browser-mockup:focus-within {
    border-color: var(--color-border-strong);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.12);
  }

  .browser-mockup:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .browser-mockup__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 12px var(--space-4);
    background-color: var(--color-surface-muted);
    border-bottom: 1px solid var(--color-border);
  }

  .browser-mockup__dots {
    display: flex;
    gap: 7px;
    flex-shrink: 0;
  }

  .browser-mockup__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: inline-block;
  }

  .browser-mockup__dot--red {
    background-color: #ef4444;
  }

  .browser-mockup__dot--yellow {
    background-color: #f59e0b;
  }

  .browser-mockup__dot--green {
    background-color: #10b981;
  }

  .browser-mockup__url {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 6px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 5px 12px;
    min-width: 0;
  }

  .browser-mockup__url-lock {
    font-size: 0.75rem;
    line-height: 1;
    opacity: 0.6;
  }

  .browser-mockup__url-text {
    font-size: var(--fs-meta);
    color: var(--color-text-subtle);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: monospace;
    letter-spacing: 0.02em;
  }

  .browser-mockup__external-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    padding: 4px;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), background-color var(--transition-fast);
    text-decoration: none;
    flex-shrink: 0;
  }

  .browser-mockup__external-btn:hover {
    color: var(--color-accent);
    background-color: var(--color-surface);
  }

  /* Viewport de l'aperçu : 800px de hauteur sur desktop */
  .browser-mockup__viewport {
    width: 100%;
    height: 800px;
    overflow: hidden;
    position: relative;
    background-color: var(--color-surface-muted);
  }

  /* Image de l'aperçu avec translation fluide et progressive */
  .browser-mockup__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: top center;
    transform: translateY(0);
    /* Transition de retour au repos : progressive et élégante */
    transition: transform 5s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
  }

  /* Défilement au survol et au focus clavier : 15s à 18s linéaire */
  .browser-mockup:hover .browser-mockup__image--scrollable,
  .browser-mockup:focus-within .browser-mockup__image--scrollable {
    transform: translateY(calc(-100% + 800px));
    transition: transform var(--scroll-duration, 16s) linear;
  }

  /* Respect de prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .browser-mockup__viewport {
      height: 700px;
      overflow-y: auto;
    }
    .browser-mockup__image,
    .browser-mockup:hover .browser-mockup__image--scrollable,
    .browser-mockup:focus-within .browser-mockup__image--scrollable {
      transition: none !important;
      transform: none !important;
    }
  }

  /* Adaptation mobile & écrans tactiles : défilement au doigt naturel */
  @media (hover: none), (max-width: 768px) {
    .mockup-hint__desktop {
      display: none;
    }
    .mockup-hint__touch {
      display: inline;
    }

    .browser-mockup__viewport {
      height: 520px;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      scroll-behavior: smooth;
    }

    .browser-mockup__image,
    .browser-mockup:hover .browser-mockup__image--scrollable,
    .browser-mockup:focus-within .browser-mockup__image--scrollable {
      transition: none !important;
      transform: none !important;
    }
  }

  /* --------------------------------------------------------------------------
     Visual Card & Palette
     -------------------------------------------------------------------------- */
  .project-visual-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .visual-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-surface-muted);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--fs-meta);
  }

  .visual-card__label {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .visual-card__canvas {
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    background: linear-gradient(160deg, var(--color-surface) 0%, var(--color-surface-muted) 100%);
  }

  .canvas-monogram {
    display: flex;
    flex-direction: column;
    align-items: center;
