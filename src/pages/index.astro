---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Divider from '../components/ui/Divider.astro';
import Tag from '../components/ui/Tag.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import StatsBar from '../components/ui/StatsBar.astro';
import Services from '../components/ui/Services.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.tagline}`}
  description={siteConfig.description}
>
  <!-- =========================================================================
       SECTION 1 — Hero principal
       ========================================================================= -->
  <section id="top" class="hero-section">
    <Container>
      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-signature">
            <Tag label="Aziz Studio — Concepteur web indépendant" variant="accent" size="md" />
          </div>

          <h1 class="hero-title">
            Je conçois des expériences web claires, soignées et utiles.
          </h1>

          <p class="hero-lead">
            Je suis Aziz, concepteur web indépendant. J'imagine et réalise des sites web en associant sens du design, WordPress, outils no-code et nouvelles technologies.
          </p>

          <div class="hero-actions">
            <Button variant="primary" href="#projets" size="lg" showArrow>
              Découvrir mes projets
            </Button>
            <Button variant="secondary" href="#approche" size="lg">
              Découvrir ma démarche
            </Button>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-portrait">
            <img
              src="/images/aziz-studio-hero.webp"
              alt="Portrait d'Aziz — Concepteur web indépendant chez Aziz Studio"
              class="hero-portrait__img"
              width="500"
              height="625"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Chiffres clés (configurables dans src/config/site.ts) -->
  <StatsBar />

  <!-- =========================================================================
       SECTION 2 — Présentation courte
       ========================================================================= -->
  <section class="section section--presentation">
    <Container width="narrow">
      <div class="presentation-block">
        <span class="presentation-eyebrow">Philosophie &amp; Démarche</span>
        <h2 class="presentation-title">Des idées aux expériences web.</h2>
        <p class="presentation-text">
          J'aime transformer des idées en interfaces web structurées, lisibles et agréables à parcourir. À travers mes projets personnels, j'explore différentes approches de conception, de WordPress aux outils et technologies web plus récents.
        </p>
      </div>
    </Container>
  </section>

  <Container>
    <Divider />
  </Container>

  <!-- =========================================================================
       SECTION 3 — Projets sélectionnés
       ========================================================================= -->
  <section id="projets" class="section section--projects">
    <Container>
      <SectionHeading
        eyebrow="Sélection de travaux"
        title="Une sélection de projets."
        description="Quelques projets personnels à travers lesquels j'explore différents univers, besoins et approches de conception web."
      />

      <div class="grid grid--3 projects-grid">
        {
          siteConfig.projects.map((project) => (
            <ProjectCard
              title={project.title}
              category={project.category}
              nature={project.nature}
              method={project.methodOrTech}
              description={project.description}
              technologies={project.technologies}
              href={`/projets/${project.id}`}
              imageSrc={project.imageSrc}
              imageAlt={project.imageAlt}
            />
          ))
        }
      </div>

      <!-- Emplacements réservés pour les futures réalisations -->
      <div class="projects-future-note">
        <div class="future-slot">
          <span class="future-slot__icon">✦</span>
          <span class="future-slot__title">Deux futurs projets en cours d'exploration</span>
          <p class="future-slot__text text-muted">
            Les prochains travaux viendront enrichir cette sélection au fil de mon apprentissage et de mes expérimentations.
          </p>
        </div>
      </div>

      <div class="projects-catalog-link">
        <Button variant="secondary" href="/projets" size="md" showArrow>
          Consulter le catalogue des projets
        </Button>
      </div>
    </Container>
  </section>

  <Container>
    <Divider />
  </Container>

  <!-- =========================================================================
       Prestations (contenu dans src/config/site.ts)
       ========================================================================= -->
  <section id="prestations" class="section section--services">
    <Container>
      <SectionHeading
        eyebrow="Prestations"
        title="Ce que je peux réaliser pour vous."
        description="Trois façons de travailler ensemble, selon votre besoin."
      />
      <Services />
      <div class="services-cta">
        <Button variant="secondary" href="/contact" size="md" showArrow>
          Parler de mon projet
        </Button>
      </div>
    </Container>
  </section>

  <Container>
    <Divider />
  </Container>

  <!-- =========================================================================
       SECTION 4 — Approche de conception
       ========================================================================= -->
  <section id="approche" class="section section--approach">
    <Container>
      <SectionHeading
        eyebrow="Méthode de travail"
        title="Une approche simple, du concept à la réalisation."
        description="Une démarche progressive pensée pour garantir la cohérence graphique, l'efficacité technique et la clarté de chaque projet."
      />

      <div class="approach-grid">
        {
          siteConfig.approach.map((step) => (
            <div class="approach-card">
              <span class="approach-card__number">{step.number}</span>
              <h3 class="approach-card__title">{step.title}</h3>
              <p class="approach-card__desc text-muted">{step.description}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <Container>
    <Divider />
  </Container>

  <!-- =========================================================================
       SECTION 5 — Compétences et outils
       ========================================================================= -->
  <section id="competences" class="section section--skills">
    <Container>
      <SectionHeading
        eyebrow="Boîte à outils"
        title="Les outils qui accompagnent ma conception."
        description="Une sélection ciblée d'outils et de savoir-faire pour concevoir des sites structurés, esthétiques et faciles à maintenir."
      />

      <div class="skills-grid">
        {
          siteConfig.skills.map((group) => (
            <div class="skill-card">
              <h3 class="skill-card__title">{group.title}</h3>
              {group.description && (
                <p class="skill-card__desc text-muted">{group.description}</p>
              )}
              <ul class="skill-card__list">
                {group.items.map((item) => (
                  <li class="skill-card__item">
                    <span class="skill-card__bullet" aria-hidden="true">•</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              {group.note && (
                <div class="skill-card__note">
                  <span class="skill-card__note-text text-subtle">{group.note}</span>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <Container>
    <Divider />
  </Container>

  <!-- =========================================================================
       SECTION 6 — Présentation personnelle courte
       ========================================================================= -->
  <section id="a-propos" class="section section--about">
    <Container>
      <div class="about-grid">
        <div class="about-visual">
          <div class="vision-photo-card">
            <div class="vision-photo-card__frame">
              <img
                src="/images/aziz-studio-vision.webp"
                alt="Aziz — Vision et démarche de conception web"
                class="vision-photo-card__img"
                width="480"
                height="600"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="vision-photo-card__caption">
              <span class="vision-photo-card__badge">Vision &amp; Atelier</span>
              <p class="vision-photo-card__text text-muted">Conception web indépendante &amp; soignée</p>
            </div>
          </div>
        </div>

        <div class="about-content">
          <span class="about-eyebrow">Parcours &amp; Vision</span>
          <h2 class="about-title">Derrière Aziz Studio.</h2>
          <p class="about-paragraph">
            Je suis Aziz, concepteur web indépendant. Mon parcours a commencé avec WordPress, qui m'a permis d'explorer la conception d'interfaces et la création de sites web.
          </p>
          <p class="about-paragraph">
            Aujourd'hui, j'élargis progressivement ma manière de travailler avec de nouveaux outils, notamment l'intelligence artificielle et Astro. Aziz Studio est l'espace où je présente mes projets, partage mon évolution et prépare de nouvelles collaborations.
          </p>
          <div class="about-footer-tags">
            <Tag label="WordPress" variant="default" />
            <Tag label="Assistance IA" variant="default" />
            <Tag label="Astro (en exploration)" variant="accent" />
          </div>

          <div class="about-more-link">
            <Button variant="secondary" href="/a-propos" size="sm" showArrow>
              En savoir plus sur mon parcours
            </Button>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <Container>
    <Divider />
  </Container>

  <!-- =========================================================================
       SECTION 7 — CTA final
       ========================================================================= -->
  <section id="contact" class="section section--cta">
    <Container width="narrow">
      <div class="cta-box">
        <span class="cta-eyebrow">Contact &amp; Échange</span>
        <h2 class="cta-title">Vous avez une idée ou un projet web ?</h2>
        <p class="cta-text text-muted">
          Je suis ouvert aux échanges et aux nouvelles collaborations autour de la conception web.
        </p>

        <div class="cta-channels">
          <a href={siteConfig.whatsappUrl} class="cta-whatsapp-link" target="_blank" rel="noopener noreferrer" aria-label="Discuter sur WhatsApp">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Discuter sur WhatsApp
          </a>
        </div>

        <div class="cta-actions">
          <Button variant="primary" href="/contact" size="md" showArrow>
            Accéder à la page de contact
          </Button>
          <Button variant="secondary" href="#top" size="md">
            Retour en haut de page
          </Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  /* --------------------------------------------------------------------------
     Section 1 : Hero
     -------------------------------------------------------------------------- */
  .hero-section {
    padding-top: clamp(3rem, 6vw, 6rem);
    padding-bottom: clamp(3.5rem, 6vw, 6rem);
    background-color: var(--color-bg);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: var(--space-8);
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .hero-signature {
    margin-bottom: var(--space-1);
  }

  .hero-title {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    color: var(--color-text);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .hero-lead {
    font-size: var(--fs-subheading);
    line-height: var(--lh-body);
    color: var(--color-text-muted);
    max-width: var(--text-max-width);
    margin: 0;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-top: var(--space-3);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-portrait {
    box-sizing: border-box;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface-muted);
  }

  .hero-portrait__img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    transition: transform var(--transition-base);
  }

  .hero-portrait:hover .hero-portrait__img {
    transform: scale(1.02);
  }

  /* --------------------------------------------------------------------------
     Section 2 : Présentation courte
     -------------------------------------------------------------------------- */
  .section--presentation {
    text-align: left;
  }

  .presentation-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .presentation-eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-meta);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .presentation-title {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    color: var(--color-text);
    margin: 0;
  }

  .presentation-text {
    font-size: var(--fs-subheading);
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* --------------------------------------------------------------------------
     Section 3 : Projets
     -------------------------------------------------------------------------- */
  .projects-grid {
    margin-bottom: var(--space-7);
  }

  .projects-future-note {
    background-color: var(--color-surface-muted);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  .future-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
    max-width: 600px;
    margin-inline: auto;
  }

  .future-slot__icon {
    font-size: 1.25rem;
    color: var(--color-accent);
  }

  .future-slot__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--color-text);
  }

  .future-slot__text {
    font-size: var(--fs-small);
    line-height: 1.55;
    margin: 0;
  }

  .projects-catalog-link {
    display: flex;
    justify-content: center;
    margin-top: var(--space-6);
  }

  /* --------------------------------------------------------------------------
     Section 4 : Approche
     -------------------------------------------------------------------------- */
  .approach-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .approach-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color var(--transition-fast);
  }

  .approach-card:hover {
    border-color: var(--color-border-strong);
  }

  .approach-card__number {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--color-accent);
  }

  .approach-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    margin: 0;
    color: var(--color-text);
  }

  .approach-card__desc {
    font-size: var(--fs-small);
    line-height: 1.6;
    margin: 0;
  }

  /* --------------------------------------------------------------------------
     Section 5 : Compétences & Outils
     -------------------------------------------------------------------------- */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .skill-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .skill-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--color-text);
    margin: 0;
  }

  .skill-card__desc {
    font-size: var(--fs-small);
    line-height: 1.5;
    margin: 0;
  }

  .skill-card__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: auto;
  }

  .skill-card__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--fs-small);
    color: var(--color-text);
  }

  .skill-card__bullet {
    color: var(--color-accent);
    font-size: 1.1rem;
    line-height: 1;
  }

  .skill-card__note {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: var(--fs-meta);
  }

  /* --------------------------------------------------------------------------
     Section 6 : À propos
     -------------------------------------------------------------------------- */
  .about-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-8);
    align-items: center;
  }

  .about-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .vision-photo-card {
    box-sizing: border-box;
    width: 100%;
    max-width: 360px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .vision-photo-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  .vision-photo-card__frame {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface-muted);
    border: 1px solid var(--color-border);
  }

  .vision-photo-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    transition: transform var(--transition-base);
  }

  .vision-photo-card:hover .vision-photo-card__img {
    transform: scale(1.02);
  }

  .vision-photo-card__caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-1) var(--space-2);
  }

  .vision-photo-card__badge {
    font-family: var(--font-body);
    font-size: var(--fs-meta);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .vision-photo-card__text {
    font-size: var(--fs-meta);
    margin: 0;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .about-eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-meta);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .about-title {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    color: var(--color-text);
    margin: 0;
  }

  .about-paragraph {
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0;
    max-width: var(--text-max-width);
  }

  .about-footer-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }

  .about-more-link {
    padding-top: var(--space-2);
  }

  /* --------------------------------------------------------------------------
     Section 7 : CTA final
     -------------------------------------------------------------------------- */
  .section--cta {
    background-color: var(--color-surface-muted);
    border-top: 1px solid var(--color-border);
  }

  .cta-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }

  .cta-eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-meta);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .cta-title {
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    color: var(--color-text);
    margin: 0;
  }

  .cta-text {
    font-size: var(--fs-subheading);
    line-height: var(--lh-body);
    max-width: 600px;
    margin: 0;
  }

  .services-cta {
    margin-top: var(--space-7);
  }

  .cta-channels {
    margin-top: var(--space-2);
  }

  .cta-whatsapp-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: #167a3c; /* vert WhatsApp assombri : contraste 4.7:1 sur le fond crème (WCAG AA) */
    font-size: var(--fs-base);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .cta-whatsapp-link:hover {
    color: #0f6b35;
  }

  .cta-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
    padding-top: var(--space-4);
  }

  /* --------------------------------------------------------------------------
     Responsive Design & Ruptures
     -------------------------------------------------------------------------- */
  @media (max-width: 1023px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .hero-visual {
      order: 0;
      justify-content: center;
      width: 100%;
    }

    .hero-portrait {
      max-width: 340px;
      margin-inline: auto;
    }

    .approach-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .about-grid {
