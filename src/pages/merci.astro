---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title={`Merci pour votre message | ${siteConfig.name}`}
  description="Votre message a bien été transmis. Merci d'avoir pris le temps de contacter Aziz Studio, je reviendrai vers vous dès que possible."
  noindex={true}
>
  <section class="merci-section">
    <Container width="narrow">
      <div class="merci-wrapper">
        <!-- Symbole de confirmation discret et élégant -->
        <div class="merci-badge" aria-hidden="true">
          <svg
            class="merci-badge__icon"
            viewBox="0 0 40 40"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="1.5" />
            <path
              d="M13 20.5L18 25.5L28 15.5"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>

        <!-- Petit élément introductif -->
        <span class="merci-eyebrow">MESSAGE BIEN REÇU</span>

        <!-- Titre principal expressif -->
        <h1 class="merci-title">Merci pour votre message.</h1>

        <!-- Paragraphes éditoriaux -->
        <div class="merci-content">
          <p class="merci-lead">
            Votre message a bien été transmis. Merci d'avoir pris le temps de me contacter et de vous intéresser à mon travail.
          </p>
          <p class="merci-paragraph text-muted">
            Je prendrai le temps de lire votre demande et reviendrai vers vous dès que possible afin d'échanger sur votre projet.
          </p>
          <p class="merci-secondary text-muted">
            En attendant, vous pouvez découvrir davantage de réalisations et en apprendre plus sur mon approche de la conception web.
          </p>
        </div>

        <!-- Actions -->
        <div class="merci-actions">
          <Button variant="primary" href="/" size="lg" class="merci-btn-home">
            Retour à l'accueil
          </Button>

          <a href="/projets" class="merci-link-secondary">
            <span>Découvrir mes réalisations</span>
            <span class="merci-link-arrow" aria-hidden="true">
              <Icon name="arrow-right" size={13} />
            </span>
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .merci-section {
    flex: 1 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(85vh - var(--header-height));
    padding-block: clamp(var(--space-8), 10vh, var(--space-12));
    width: 100%;
    background-color: var(--color-bg);
  }

  /* Composition libre sans carte, directement sur le fond */
  .merci-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 620px;
    margin-inline: auto;
  }

  /* Symbole graphique fin et discret */
  .merci-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-accent-soft);
    color: var(--color-accent);
    margin-bottom: var(--space-5);
  }

  .merci-badge__icon {
    width: 28px;
    height: 28px;
  }

  /* Petit texte introductif */
  .merci-eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-meta);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
    line-height: 1;
  }

  /* Titre expressif en Instrument Serif */
  .merci-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 400;
    line-height: var(--lh-h1);
    color: var(--color-text);
    margin-bottom: var(--space-6);
    text-wrap: balance;
  }

  /* Corps rédactionnel fluide */
  .merci-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 52ch;
    margin-bottom: var(--space-8);
  }

  .merci-lead {
    font-size: var(--fs-subheading);
    font-weight: 500;
    color: var(--color-text);
    line-height: var(--lh-body);
  }

  .merci-paragraph {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .merci-secondary {
    font-size: var(--fs-small);
    line-height: var(--lh-body);
  }

  /* Actions */
  .merci-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
  }

  :global(.merci-btn-home) {
    min-width: 220px;
  }

  /* Lien secondaire discret */
  .merci-link-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast);
  }

  .merci-link-secondary:hover {
    color: var(--color-accent);
  }

  .merci-link-arrow {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .merci-link-secondary:hover .merci-link-arrow {
    transform: translateX(3px);
  }

  .merci-link-secondary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Responsive Mobile */
  @media (max-width: 640px) {
    .merci-section {
      min-height: auto;
      padding-block: var(--space-9) var(--space-10);
    }

    .merci-badge {
      width: 44px;
      height: 44px;
      margin-bottom: var(--space-4);
    }

    .merci-badge__icon {
      width: 24px;
      height: 24px;
    }

    .merci-title {
      font-size: clamp(2rem, 8vw, 2.75rem);
      margin-bottom: var(--space-5);
    }

    .merci-content {
      gap: var(--space-3);
      margin-bottom: var(--space-7);
    }

    :global(.merci-btn-home) {
      width: 100%;
    }
  }

  /* Respect des préférences de réduction de mouvement */
  @media (prefers-reduced-motion: reduce) {
    .merci-link-arrow,
    .merci-link-secondary {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
