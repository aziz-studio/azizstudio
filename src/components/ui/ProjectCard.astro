---
import Tag from './Tag.astro';

interface Props {
  title: string;
  category: string;
  description: string;
  nature?: string;
  method?: string;
  technologies?: string[];
  href?: string;
  imageSrc?: string;
  imageAlt?: string;
  badge?: string;
  isDemo?: boolean;
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const {
  title,
  category,
  description,
  nature = 'Projet personnel',
  method,
  technologies = [],
  href,
  imageSrc,
  imageAlt = `Illustration du projet ${title}`,
  isDemo = false,
  headingLevel = 'h3',
  badge = isDemo ? 'Démonstration' : nature,
  class: className = '',
} = Astro.props;
---

<article class:list={['project-card', className]}>
  <div class="project-card__media">
    {
      imageSrc ? (
        <img
          src={imageSrc}
          alt={imageAlt}
          class="project-card__image"
          width="800"
          height="500"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="project-card__placeholder" aria-hidden="true">
          <div class="placeholder-graphic">
            <span class="placeholder-icon">✦</span>
            <span class="placeholder-title">{title}</span>
            <span class="placeholder-sub">Illustration de concept</span>
          </div>
        </div>
      )
    }
    {badge && <span class="project-card__badge">{badge}</span>}
  </div>

  <div class="project-card__content">
    <div class="project-card__header">
      <div class="project-card__meta-line">
        <span class="project-card__category">{category}</span>
        {method && <span class="project-card__method">{method}</span>}
      </div>
      {
        headingLevel === 'h2' ? (
          <h2 class="project-card__title">
            {href ? (
              <a href={href} class="project-card__link">
                {title}
              </a>
            ) : (
              title
            )}
          </h2>
        ) : (
          <h3 class="project-card__title">
            {href ? (
              <a href={href} class="project-card__link">
                {title}
              </a>
            ) : (
              title
            )}
          </h3>
        )
      }
    </div>

    <p class="project-card__description">{description}</p>

    {
      technologies.length > 0 && (
        <div class="project-card__tags">
          {technologies.map((tech) => (
            <Tag label={tech} size="sm" variant="default" />
          ))}
        </div>
      )
    }

    {
      href && (
        <div class="project-card__footer">
          <a href={href} class="project-card__cta">
            <span>Découvrir l'étude</span>
            <span class="project-card__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .project-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-card);
  }

  .project-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: var(--color-surface-muted);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .project-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform var(--transition-base);
  }

  .project-card:hover .project-card__image {
    transform: scale(1.02);
  }

  .project-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, var(--color-surface-muted) 0%, #EDE7DF 100%);
    padding: var(--space-4);
  }

  .placeholder-graphic {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  .placeholder-icon {
    font-size: 1.4rem;
    color: var(--color-accent);
  }

  .placeholder-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--color-text);
  }

  .placeholder-sub {
    font-size: var(--fs-meta);
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
  }

  .project-card__badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background-color: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-subtle);
  }

  .project-card__content {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    gap: var(--space-3);
    flex-grow: 1;
  }

  .project-card__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .project-card__meta-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .project-card__category {
    font-family: var(--font-body);
    font-size: var(--fs-meta);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .project-card__method {
    font-family: var(--font-body);
    font-size: var(--fs-meta);
    color: var(--color-text-subtle);
  }

  .project-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    margin: 0;
  }

  .project-card__link {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .project-card__link:hover {
    color: var(--color-accent);
  }

  .project-card__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .project-card__description {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
    flex-grow: 1;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-2);
  }

  .project-card__footer {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .project-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .project-card__cta:hover {
    color: var(--color-accent);
  }

  .project-card__arrow {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .project-card__cta:hover .project-card__arrow {
    transform: translateX(3px);
  }

  .project-card__cta:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (max-width: 639px) {
    .project-card__content {
      padding: var(--space-5);
    }
  }
</style>
