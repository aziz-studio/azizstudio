---
import Tag from './Tag.astro';
import { siteConfig, type ServiceItem } from '../../config/site';

interface Props {
  services?: ServiceItem[];
}

const { services = siteConfig.services } = Astro.props;
---

{
  services.length > 0 && (
    <ol class="services">
      {services.map((service) => (
        <li class="services__item">
          <span class="services__number" aria-hidden="true">
            {service.number}
          </span>
          <div class="services__content">
            <h3 class="services__title">{service.title}</h3>
            <p class="services__description">{service.description}</p>
            <ul class="services__tags" aria-label="Outils et domaines">
              {service.tags.map((tag) => (
                <li>
                  <Tag label={tag} size="sm" />
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .services {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: var(--border-default);
  }

  .services__item {
    display: grid;
    grid-template-columns: minmax(3rem, 6rem) 1fr;
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-top: var(--border-default);
  }

  .services__number {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: 1;
    color: var(--color-accent);
  }

  .services__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 52rem;
  }

  .services__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-h3);
    line-height: 1.15;
    color: var(--color-text);
  }

  .services__description {
    margin: 0;
    max-width: var(--text-max-width);
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .services__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 640px) {
    .services__item {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
