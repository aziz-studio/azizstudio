---
import Icon from './Icon.astro';

interface Props {
  href: string;
  external?: boolean;
  underline?: 'always' | 'hover';
  class?: string;
  [key: string]: any;
}

const {
  href,
  external = false,
  underline = 'hover',
  class: className = '',
  ...rest
} = Astro.props;

const isExternal = external || href.startsWith('http') || href.startsWith('//');
---

<a
  href={href}
  class:list={['text-link', `text-link--${underline}`, className]}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  {...rest}
>
  <span class="text-link__label"><slot /></span>
  {isExternal && (
    <span class="text-link__icon" aria-hidden="true">
      <Icon name="arrow-up-right" size={12} />
    </span>
  )}
</a>

<style>
  .text-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-1);
    color: var(--color-text);
    text-decoration: none;
    font-size: inherit;
    line-height: inherit;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .text-link__label {
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition-fast);
  }

  .text-link--always .text-link__label {
    border-bottom-color: var(--color-border-strong);
  }

  .text-link:hover {
    color: var(--color-accent);
  }

  .text-link:hover .text-link__label {
    border-bottom-color: var(--color-accent);
  }

  .text-link__icon {
    font-size: 0.85em;
    transform: translateY(-1px);
    transition: transform var(--transition-fast);
  }

  .text-link:hover .text-link__icon {
    transform: translate(2px, -2px);
  }

  .text-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
</style>
