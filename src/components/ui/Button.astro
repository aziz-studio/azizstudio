---
interface Props {
  variant?: 'primary' | 'secondary' | 'text';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  showArrow?: boolean;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  disabled = false,
  showArrow = variant === 'text',
  size = 'md',
  class: className = '',
  ...rest
} = Astro.props;

const isLink = typeof href === 'string' && href.length > 0;
---

{
  isLink ? (
    <a
      href={disabled ? undefined : href}
      class:list={[
        'btn',
        `btn--${variant}`,
        `btn--${size}`,
        { 'is-disabled': disabled },
        className,
      ]}
      role={disabled ? 'link' : undefined}
      aria-disabled={disabled ? 'true' : undefined}
      tabindex={disabled ? -1 : undefined}
      {...rest}
    >
      <span class="btn__label"><slot /></span>
      {showArrow && (
        <span class="btn__arrow" aria-hidden="true">
          →
        </span>
      )}
    </a>
  ) : (
    <button
      type={type}
      disabled={disabled}
      class:list={[
        'btn',
        `btn--${variant}`,
        `btn--${size}`,
        className,
      ]}
      {...rest}
    >
      <span class="btn__label"><slot /></span>
      {showArrow && (
        <span class="btn__arrow" aria-hidden="true">
          →
        </span>
      )}
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
    white-space: nowrap;
    border: 1px solid transparent;
  }

  /* Tailles */
  .btn--sm {
    padding: 8px 16px;
    font-size: var(--fs-meta);
  }

  .btn--md {
    padding: 12px 24px;
    font-size: var(--fs-small);
  }

  .btn--lg {
    padding: 16px 32px;
    font-size: var(--fs-body);
  }

  /* Variante Primaire */
  .btn--primary {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
    border-color: var(--color-accent);
  }

  .btn--primary:hover:not(:disabled):not(.is-disabled) {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .btn--primary:active:not(:disabled):not(.is-disabled) {
    transform: translateY(1px);
  }

  /* Variante Secondaire */
  .btn--secondary {
    background-color: var(--color-surface);
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .btn--secondary:hover:not(:disabled):not(.is-disabled) {
    background-color: var(--color-surface-muted);
    border-color: var(--color-text);
  }

  .btn--secondary:active:not(:disabled):not(.is-disabled) {
    transform: translateY(1px);
  }

  /* Variante Texte / Lien */
  .btn--text {
    background-color: transparent;
    color: var(--color-text);
    border-color: transparent;
    padding-inline: 0;
    border-radius: 0;
  }

  .btn--text:hover:not(:disabled):not(.is-disabled) {
    color: var(--color-accent);
  }

  .btn--text .btn__label {
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition-fast);
  }

  .btn--text:hover:not(:disabled):not(.is-disabled) .btn__label {
    border-bottom-color: var(--color-accent);
  }

  /* Flèche */
  .btn__arrow {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .btn:hover:not(:disabled):not(.is-disabled) .btn__arrow {
    transform: translateX(3px);
  }

  /* Focus accessible */
  .btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* État Désactivé */
  .btn:disabled,
  .btn.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
    box-shadow: none;
  }
</style>
